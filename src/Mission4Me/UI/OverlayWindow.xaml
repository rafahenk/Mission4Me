<Window x:Class="Mission4Me.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mission4Me" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Focusable="False" Cursor="Hand" Width="280" Height="40" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border x:Name="Pill" CornerRadius="7" BorderThickness="1" ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#10FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="G1" Color="#0B6E79" Offset="0"/>
                <GradientStop x:Name="G2" Color="#1E5AA8" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- destaque ao passar o mouse -->
            <Border x:Name="Hover" CornerRadius="6" Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False"/>

            <!-- brilho sutil no topo (efeito vidro) -->
            <Border VerticalAlignment="Top" Height="12" CornerRadius="6,6,0,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1FFFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- indicador "ao vivo" -->
                <Grid Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0">
                    <Ellipse x:Name="PulseHalo" Fill="#2EC4B6" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="PulseDot" Fill="#2EC4B6" Width="6" Height="6"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectText" Text="Projeto" Foreground="#F0FFFC" FontSize="12.5"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MetaText" Text="meta 50 min · 0%" Foreground="#F0FFFC" Opacity="0.72"
                               FontSize="10.5" FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock x:Name="ClockText" Grid.Column="2" Text="50:00" Foreground="#F0FFFC"
                           FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="19"
                           VerticalAlignment="Center" Margin="10,0,0,1"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <!-- barra de progresso fina na base -->
            <Grid x:Name="Track" VerticalAlignment="Bottom" Height="3" Margin="6,0,6,3">
                <Border Background="#26FFFFFF" CornerRadius="1.5"/>
                <Border x:Name="ProgressFill" Background="#2EC4B6" CornerRadius="1.5"
                        HorizontalAlignment="Left" Width="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
