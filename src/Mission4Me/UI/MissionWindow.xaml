<Window x:Class="Mission4Me.UI.MissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Mission4Me.UI"
        Title="Mission4Me" SizeToContent="WidthAndHeight" Icon="pack://application:,,,/Assets/Mission4Me.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="True" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="Card" Width="404" VerticalAlignment="Top">
        <!-- sombra -->
        <Border CornerRadius="16" Background="#000000" Opacity="0.55" Margin="2,6,2,-6">
            <Border.CacheMode><BitmapCache/></Border.CacheMode>
            <Border.Effect><BlurEffect Radius="18"/></Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                MouseLeftButtonDown="OnDrag" ClipToBounds="True">
            <StackPanel>
                <!-- faixa de cor no topo: a mesma assinatura da barra em missão -->
                <Border Height="4" Background="{Binding Source={x:Static ui:LagoonBrush.Brush}}" CornerRadius="16,16,0,0"/>

                <StackPanel Margin="26,18,26,24">
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="HeaderLabel" Text="NOVA MISSÃO" Foreground="{StaticResource Teal}" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,0,0,4">
                                <TextBlock.Effect><DropShadowEffect Color="#2EC4B6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="HeaderTitle" Text="No que você vai focar agora?" Foreground="{StaticResource Text}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="OnClose" ToolTip="Fechar (Esc)">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1.4"/>
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="10" Padding="3" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ModeCurrent" Style="{StaticResource Segment}" Tag="selected" Click="OnModeCurrent" Content="Missão atual"/>
                            <Button x:Name="ModeNext" Grid.Column="1" Style="{StaticResource Segment}" Tag="" Click="OnModeNext" Content="Próxima missão"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="MainPanel">
                    <TextBlock Text="Projeto" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="ProjectBox" Style="{StaticResource Field}" MaxLength="60"
                             TextChanged="OnInputChanged"/>
                    <WrapPanel x:Name="RecentPanel" Margin="0,10,0,0"/>

                    <TextBlock x:Name="DurationLabel" Text="Tempo da missão" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
                    <WrapPanel x:Name="PresetPanel">
                        <Button Style="{StaticResource Chip}" Content="25 min" Tag="" Click="OnPreset" CommandParameter="25"/>
                        <Button Style="{StaticResource Chip}" Content="50 min" Tag="" Click="OnPreset" CommandParameter="50"/>
                        <Button Style="{StaticResource Chip}" Content="1h30"   Tag="" Click="OnPreset" CommandParameter="90"/>
                        <Button Style="{StaticResource Chip}" Content="2h"     Tag="" Click="OnPreset" CommandParameter="120"/>
                        <Button Style="{StaticResource Chip}" Content="3h"     Tag="" Click="OnPreset" CommandParameter="180"/>
                    </WrapPanel>
                    <TextBox x:Name="DurationBox" Style="{StaticResource Field}" Margin="0,2,0,0"
                             TextChanged="OnInputChanged" ToolTip="Ex.: 45, 90m, 1h30, 1:15, 2h"/>
                    <TextBlock x:Name="HintText" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"
                               Text="Ex.: 45 · 90m · 1h30 · 1:15" TextWrapping="Wrap"/>

                    <Button x:Name="StartButton" Style="{StaticResource Primary}" Margin="0,22,0,0"
                            Click="OnStart" IsDefault="True" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="StartIcon" Data="M0,0 L9,5.5 L0,11 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StartText" Text="Iniciar missão"/>
                        </StackPanel>
                    </Button>

                    <!-- só no modo edição -->
                    <Grid x:Name="EditActions" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseButton" Style="{StaticResource Secondary}" Click="OnPause">
                            <TextBlock x:Name="PauseText" Text="❚❚  Pausar"/>
                        </Button>
                        <Button x:Name="EndButton" Grid.Column="2" Style="{StaticResource Danger}" Click="OnEnd" Tag="">
                            <TextBlock x:Name="EndText" Text="■  Encerrar missão"/>
                        </Button>
                    </Grid>
                    <Button x:Name="InterruptButton" Style="{StaticResource WarnSecondary}" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="OnInterruptOpen">
                        <TextBlock Text="⚡  Registrar interrupção"/>
                    </Button>
                    </StackPanel>

                    <!-- ===== Próxima missão (entra na fila) ===== -->
                    <StackPanel x:Name="NextPanel" Visibility="Collapsed">
                        <TextBlock Text="Projeto" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="NextProjectBox" Style="{StaticResource Field}" MaxLength="60" TextChanged="OnNextInputChanged"/>

                        <TextBlock Text="Tempo previsto" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="NextPresetPanel">
                            <Button Style="{StaticResource Chip}" Content="25 min" Tag="" Click="OnNextPreset" CommandParameter="25"/>
                            <Button Style="{StaticResource Chip}" Content="50 min" Tag="" Click="OnNextPreset" CommandParameter="50"/>
                            <Button Style="{StaticResource Chip}" Content="1h30"   Tag="" Click="OnNextPreset" CommandParameter="90"/>
                            <Button Style="{StaticResource Chip}" Content="2h"     Tag="" Click="OnNextPreset" CommandParameter="120"/>
                            <Button Style="{StaticResource Chip}" Content="3h"     Tag="" Click="OnNextPreset" CommandParameter="180"/>
                        </WrapPanel>
                        <TextBox x:Name="NextDurationBox" Style="{StaticResource Field}" Margin="0,2,0,0"
                                 TextChanged="OnNextInputChanged" ToolTip="Ex.: 45, 90m, 1h30, 1:15, 2h"/>
                        <TextBlock x:Name="NextHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="NextAddButton" Style="{StaticResource Primary}" Margin="0,22,0,0"
                                Click="OnNextAdd" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5.5,0 V11 M0,5.5 H11" Stroke="White" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Adicionar à fila"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ===== Registrar interrupção (só com missão ativa) ===== -->
                    <StackPanel x:Name="InterruptPanel" Visibility="Collapsed">
                        <TextBlock Text="O que te tirou do foco?" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                        <StackPanel x:Name="InterruptOptions"/>

                        <StackPanel x:Name="CustomReasonPanel" Visibility="Collapsed">
                            <TextBlock Text="O que aconteceu?" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,6"/>
                            <TextBox x:Name="ReasonBox" Style="{StaticResource Field}" MaxLength="120"
                                     TextChanged="OnInterruptInputChanged"/>
                        </StackPanel>

                        <TextBlock Text="Tempo da interrupção" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,6"/>
                        <TextBox x:Name="InterruptDurationBox" Style="{StaticResource Field}"
                                 TextChanged="OnInterruptInputChanged" ToolTip="Ex.: 15, 30, 1h, 1h30"/>

                        <CheckBox x:Name="AddTimeCheck" Style="{StaticResource Check}" Margin="0,16,0,0" IsChecked="False"
                                  Checked="OnInterruptCheck" Unchecked="OnInterruptCheck"
                                  Content="Acrescentar esse tempo à meta da missão"/>
                        <TextBlock x:Name="InterruptHint" Foreground="{StaticResource Muted}" FontSize="11.5"
                                   Margin="28,5,0,0" TextWrapping="Wrap"/>

                        <Button x:Name="InterruptConfirm" Style="{StaticResource WarnPrimary}" Margin="0,18,0,0"
                                Click="OnInterruptConfirm" IsEnabled="False">
                            <TextBlock Text="Registrar interrupção"/>
                        </Button>
                        <Button Style="{StaticResource Link}" Content="← Voltar para a missão" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Click="OnInterruptBack"/>
                    </StackPanel>

                    <TextBlock x:Name="TodayText" Foreground="{StaticResource Muted}" FontSize="11.5"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>

                    <!-- ===== Atalho de teclado ===== -->
                    <Border Height="1" Background="{StaticResource Line}" Margin="-26,16,-26,0"/>
                    <Grid Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M1,1 H15 V10 H1 Z M4,4 H5 M7,4 H8 M10,4 H11 M5,7 H11" Stroke="{StaticResource Muted}"
                                  StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Atalho" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                            <Border CornerRadius="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" Padding="7,2" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HotkeyBadgeText" Text="Ctrl+Alt+M" Foreground="{StaticResource Text}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
                            </Border>
                            <TextBlock x:Name="HotkeyStatus" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="HotkeyEditButton" Style="{StaticResource Link}" Content="Alterar"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnHotkeyEdit"/>
                    </Grid>

                    <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 FontFamily="Cascadia Mono, Consolas" HorizontalContentAlignment="Center"
                                 PreviewKeyDown="OnHotkeyKey" Cursor="Arrow"/>
                        <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="Pressione a nova combinação: Ctrl e/ou Alt (Shift opcional) + letra, número ou F1–F12. Esc cancela."/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>

        <!-- ===== Abas laterais: A FAZER (fila) e HISTÓRICO ===== -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="-1,64,0,0">
        <Button x:Name="QueueTab" Style="{StaticResource SideTab}" Margin="0,0,0,8" Click="OnQueueToggle" ToolTip="Próximas missões">
            <StackPanel>
                <Path Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Teal}" StrokeThickness="1.6"
                      HorizontalAlignment="Center" Margin="0,0,0,10" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform x:Name="QueueChevronFlip" ScaleX="1"/></Path.RenderTransform>
                </Path>
                <TextBlock Text="A FAZER" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                </TextBlock>
                <Border x:Name="QueueBadge" Background="#103A3A" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                        Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="QueueBadgeText" Foreground="{StaticResource Teal}" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Button>
        <Button x:Name="HistoryTab" Style="{StaticResource SideTab}" Click="OnHistoryToggle" ToolTip="Histórico de missões">
            <StackPanel>
                <Path Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Teal}" StrokeThickness="1.6"
                      HorizontalAlignment="Center" Margin="0,0,0,10" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform x:Name="ChevronFlip" ScaleX="1"/></Path.RenderTransform>
                </Path>
                <TextBlock Text="HISTÓRICO" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="SemiBold">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Button>
        </StackPanel>

        <!-- ===== Painel lateral (desliza para a direita): fila ou histórico ===== -->
        <Grid x:Name="HistoryHost" Grid.Column="2" Width="0" ClipToBounds="True" VerticalAlignment="Top"
              Height="{Binding ActualHeight, ElementName=Card}">
            <!-- ===== A FAZER ===== -->
            <Border x:Name="QueuePanel" Width="400" Margin="8,0,0,0" HorizontalAlignment="Left" CornerRadius="16"
                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="20,18,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="A FAZER" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Próximas missões" Foreground="{StaticResource Text}"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- adição rápida -->
                    <Grid Grid.Row="1" Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickProject" Style="{StaticResource FieldSm}" MaxLength="60"
                                 TextChanged="OnQuickChanged" PreviewKeyDown="OnQuickKey"/>
                        <TextBlock x:Name="QuickPlaceholder" Text="Nova missão na fila…" Foreground="{StaticResource Muted}"
                                   FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="QuickMinutes" Grid.Column="2" Style="{StaticResource FieldSm}" ToolTip="Tempo previsto"
                                 TextChanged="OnQuickChanged" PreviewKeyDown="OnQuickKey"/>
                        <Button x:Name="QuickAdd" Grid.Column="4" Style="{StaticResource Secondary}" Width="38" Height="34"
                                Click="OnQuickAdd" IsEnabled="False" ToolTip="Adicionar à fila (Enter)">
                            <Path Data="M5.5,0 V11 M0,5.5 H11" Stroke="{StaticResource Teal}" StrokeThickness="2"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel x:Name="QueueList" Margin="0,0,0,24"/>
                        </ScrollViewer>
                        <TextBlock x:Name="QueueEmpty" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,24,10,0"
                                   Visibility="Collapsed"
                                   Text="Nada na fila. Use o campo acima ou a opção “Próxima missão” para guardar o que vem depois."/>
                        <Border Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000D141C" Offset="0"/>
                                    <GradientStop Color="#FF0D141C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="QueueFooter" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                               Margin="2,6,0,0" Text="Clique numa missão para trazê-la para a execução."/>
                </Grid>
            </Border>

            <!-- ===== HISTÓRICO ===== -->
            <Border x:Name="HistoryPanel" Width="400" Margin="8,0,0,0" HorizontalAlignment="Left" CornerRadius="16"
                    Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid Margin="20,18,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="HISTÓRICO" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Suas missões" Foreground="{StaticResource Text}"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <WrapPanel x:Name="PeriodChips"/>
                        <WrapPanel x:Name="StatusChips"/>
                        <Grid>
                            <TextBox x:Name="ProjectFilter" Style="{StaticResource Field}" FontSize="13" Padding="10,7"
                                     TextChanged="OnHistoryFilterChanged"/>
                            <TextBlock x:Name="FilterPlaceholder" Text="Filtrar por projeto…" Foreground="{StaticResource Muted}"
                                       FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="10" Padding="12,9" Margin="0,12,0,10">
                        <TextBlock x:Name="HistorySummary" Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Grid.Row="3">
                        <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                            <StackPanel x:Name="HistoryList" Margin="0,0,0,24"/>
                        </ScrollViewer>
                        <TextBlock x:Name="HistoryEmpty" Text="Nenhuma missão neste filtro." Foreground="{StaticResource Muted}"
                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                                   Visibility="Collapsed"/>
                        <Border Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000D141C" Offset="0"/>
                                    <GradientStop Color="#FF0D141C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
